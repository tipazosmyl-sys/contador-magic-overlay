{
  "name": "contador-magic-overlay",
  "version": "1.0.0",
  "description": "Contador de daño Magic sin bordes y superponible",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64 --ia32"
  },
  "author": "Tu Nombre",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.magic.overlay.counter",
    "productName": "Magic Overlay Counter",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-portable-${version}.exe"
    }
  }
}
